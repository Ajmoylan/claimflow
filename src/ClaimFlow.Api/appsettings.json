{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "ConnectionStrings": {
    "ClaimFlow": "Data Source=claimflow.dev.db"
  },
  "Demo": {
    "MaxVisitorClaims": 200,
    "AutoResetEnabled": true,
    "ResetTimeOfDay": "03:00",
    "ResetTimeZone": "Europe/Oslo",
    "CheckInterval": "00:15:00"
  },
  "RateLimiting": {
    "RequestsPerMinute": 120,
    "WritesPerMinute": 10,
    "GlobalWritesPerMinute": 60
  }
}
